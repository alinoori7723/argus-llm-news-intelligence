{
  "name": "argus-llm-news-intelligence",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Source-grounded LLM news intelligence system with deterministic ingestion, auditable generation, and reproducible runtime telemetry.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.pipeline.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "pipeline:replay": "node --import tsx pipeline/cli.ts --provider fixture",
    "pipeline:live": "node --env-file-if-exists=.env.local --import tsx pipeline/cli.ts --provider openai",
    "pipeline:verify": "node --import tsx pipeline/cli.ts",
    "demo:generate": "node --import tsx pipeline/cli.ts --demo",
    "demo:verify": "node --import tsx scripts/verify-demo.ts",
    "eval": "node --import tsx scripts/evaluate.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm demo:verify && pnpm eval && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.28",
    "prettier": "3.6.2",
    "tailwindcss": "^3.4.19",
    "tsx": "4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.19.0"
}
